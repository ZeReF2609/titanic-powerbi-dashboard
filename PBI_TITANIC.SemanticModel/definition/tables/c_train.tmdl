	column Estado = IF(c_train[Survived] = 1, "Sobrevivió", "No sobrevivió")
		dataType: string
		lineageTag: 7293fd5e-c192-40a6-a5a2-a002a790ffec
		summarizeBy: none

	column Clase = SWITCH(c_train[Pclass], 1, "1ª clase", 2, "2ª clase", 3, "3ª clase")
		dataType: string
		lineageTag: 81afb17e-f811-4f66-a821-084f0bfc9e87
		summarizeBy: none

	column Sexo = IF(c_train[Sex] = "male", "Hombre", "Mujer")
		dataType: string
		lineageTag: c864c79f-cd02-404b-9c25-5229f4ab3e42
		summarizeBy: none

	column Puerto = SWITCH(c_train[Embarked], "S", "Southampton", "C", "Cherbourg", "Q", "Queenstown", "Sin dato")
		dataType: string
		lineageTag: 4796b967-263c-43d8-97fe-70d1b0353e96
		summarizeBy: none

	column 'Orden Edad' = IF(ISBLANK(c_train[Age]), 6, SWITCH(TRUE(), c_train[Age] < 13, 1, c_train[Age] < 18, 2, c_train[Age] < 35, 3, c_train[Age] < 60, 4, 5))
		dataType: int64
		lineageTag: 2e7f245c-a19b-42c9-bef6-311b3e8daf99
		summarizeBy: none

	column 'Grupo Edad' = SWITCH(c_train[Orden Edad], 1, "0-12", 2, "13-17", 3, "18-34", 4, "35-59", 5, "60+", "Sin dato")
		dataType: string
		lineageTag: b6c29507-b3d7-4341-a58c-4b04f4bd3a47
		summarizeBy: none
		sortByColumn: 'Orden Edad'

	column 'Tamaño Familia' = c_train[SibSp] + c_train[Parch] + 1
		dataType: int64
		lineageTag: 7160cfac-c7b0-442b-82e8-98d47351f537
		summarizeBy: none

