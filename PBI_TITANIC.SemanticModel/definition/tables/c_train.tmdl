table c_train
	lineageTag: 71b7ea8a-7c7e-4519-b380-caea9ab5be03

	measure Pasajeros = COUNTROWS(c_train)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 2d46e4fc-d567-4fd6-84e0-9fe630b22006

	measure Sobrevivientes = CALCULATE(COUNTROWS(c_train), c_train[Survived] = 1)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 57d3e8d0-814d-4db4-9d02-b1a47ef5231f

	measure Fallecidos = [Pasajeros] - [Sobrevivientes]
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 1edce117-fc32-4aa8-b385-0403d6084016

	measure 'Tasa de Supervivencia' = DIVIDE([Sobrevivientes], [Pasajeros])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 746950f0-c3c3-4af4-90e3-63129400bbf1

	measure 'Edad Promedio' = AVERAGE(c_train[Age])
		formatString: 0.0
		displayFolder: KPIs
		lineageTag: 937dc717-654c-4cda-aae7-3441d2d67b25

	measure 'Tarifa Promedio' = AVERAGE(c_train[Fare])
		formatString: #,0.00
		displayFolder: KPIs
		lineageTag: 6e4ed37c-c167-4754-aacf-a181e29390f0

